# ============================================================
# CelStore™ Atelier — Variables de Entorno
# Copia este archivo a `.env.local` y completá los valores.
#   cp .env.example .env.local
# ============================================================

# ---------- Supabase (REQUERIDO) ----------
# URL del proyecto: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service Role key (TAMBIÉN require derecho de service_role).
# ⚠️ Solo se usa en el servidor (API Routes de Next.js). NUNCA la expongas al frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key (lectura pública vía RLS; opcional si usás solo service role)
SUPABASE_ANON_KEY=your-anon-key

# ---------- Autenticación ----------
# Secreto para firmar tokens de sesión (cambialo obligatoriamente en producción)
AUTH_SECRET=generate-a-long-random-string-here

# Password del SuperAdmin Global (login: superadmin@platform.com)
ADMIN_PASSWORD=admin123

# ---------- Aplicación ----------
# URL pública del deploy (usada en back_urls de MercadoPago)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- MercadoPago (opcional) ----------
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# ---------- Depth Map (opcional) ----------
REPLICATE_API_TOKEN=your-replicate-token